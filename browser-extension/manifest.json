{
  "manifest_version": 3,
  "name": "YouTube Current Track Reporter",
  "version": "1.1.0",
  "description": "Reports the exact playing YouTube video to the local ytm_like agent.",
  "permissions": ["storage"],
  "background": {"service_worker": "background.js"},
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "http://127.0.0.1:8888/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
    "js": ["reporter.js"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html"
}
